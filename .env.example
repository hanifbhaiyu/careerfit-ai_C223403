# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED. Free key from https://aistudio.google.com/apikey
# Used for the chat model, embeddings, vision OCR fallback, and Search grounding.
GOOGLE_API_KEY=your-google-ai-studio-key

# Model selection
CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.2

# OPTIONAL. Internet search provider. Free tier at https://tavily.com
# If left blank the app falls back to DuckDuckGo, which needs no key.
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# RAG settings
VECTOR_STORE_DIR=data/faiss_index
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=4

# OCR. Leave TESSERACT_CMD blank if tesseract is on your PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_FALLBACK_TO_VISION=true

# LangSmith tracing. Free key from https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=careerfit-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Server
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_MB=10
